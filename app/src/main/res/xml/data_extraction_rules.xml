<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Financial records are kept on device. Transfer only by explicit JSON export. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
